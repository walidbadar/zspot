/*
 * The audio goes out through the I2S driver of the board, to the host's
 * ALSA device (see native_sim_native_64.conf).
 */
/ {
	aliases {
		zspot-i2s = &i2s_tx0;
	};
};

&fuel_gauge0 {
	status = "okay";
};

&sdl_dc {
	width = <320>;
	height = <480>;
};
