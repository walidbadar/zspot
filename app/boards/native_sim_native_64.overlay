/*
 * The audio goes out through the file-backed I2S driver of the board; see
 * CONFIG_ZSPOT_PCM_COMMAND for where. The battery of the host is shown on the
 * screen when the host has one of this name.
 */
/ {
	aliases {
		fuel-gauge0 = &fuel_gauge0;
		zspot-i2s = &i2s_tx0;
	};

	fuel_gauge0: fuel_gauge {
		compatible = "zephyr,native-linux-fuel-gauge";
		path = "BAT0";
		status = "okay";
	};
};

&sdl_dc {
	width = <320>;
	height = <480>;
};
