/*
 * The audio goes out through the file-backed I2S driver of the board; see
 * CONFIG_ZSPOT_PCM_COMMAND for where.
 */
/ {
	aliases {
		zspot-i2s = &i2s_tx0;
	};
};

&fuel_gauge0 {
	status = "okay";
};

&sdl_dc {
	width = <320>;
	height = <480>;
};
