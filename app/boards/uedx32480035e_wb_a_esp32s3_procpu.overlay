/*
 * VIEWE UEDX32480035E-WB-A in landscape (480x320).
 *
 * MADCTL: MV (0x20) exchanges rows and columns, BGR (0x08) is the colour
 * order of the panel. The board's portrait value is 0x48 (MX | BGR). If the
 * picture is upside down for the way the board is mounted, use 0xe8
 * (MY | MX | MV | BGR), and for the touch "inverted-y" instead of
 * "inverted-x".
 */
&st7796s {
	width = <480>;
	height = <320>;
	madctl = <0x28>;
};

/*
 * The touch controller keeps reporting in the panel's own 320x480 space,
 * which screen-width and screen-height describe. Landscape x is the panel's
 * y, and landscape y runs against the panel's x.
 */
&chsc6x {
	screen-width = <320>;
	screen-height = <480>;
	inverted-x;
	swapped-x-y;
};
