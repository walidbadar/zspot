/*
 * VIEWE UEDX32480035E-WB-A (ESP32-S3): external I2S DAC on free GPIOs.
 * DATA = GPIO5, BCK = GPIO6, WS (LRCK) = GPIO7. The remaining GPIOs are used
 * by the display, touch, SD card, USB, RGB LED and buzzer.
 */

/ {
	aliases {
		zspot-i2s = &i2s0;
	};
};

&pinctrl {
	i2s0_zspot: i2s0_zspot {
		group1 {
			pinmux = <I2S0_O_SD_GPIO5>,	/* DIN */
				 <I2S0_O_BCK_GPIO6>,
				 <I2S0_O_WS_GPIO7>;	/* LRC */

			output-low;
		};
	};
};

&i2s0 {
	status = "okay";
	pinctrl-0 = <&i2s0_zspot>;
	pinctrl-names = "default";
};

/* Not needed by the player; frees the SDMMC pins and driver memory. */
&sdhc0 {
	status = "disabled";
};
