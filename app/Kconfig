mainmenu "zspot player"

menu "zspot player"

config ZSPOT_PCM_TAP
	bool "PCM tap: copy of the audio over TCP"
	select RING_BUFFER_LARGE
	help
	  Starts a TCP server that sends a copy of the PCM handed to the sink
	  (16-bit little-endian stereo at 44.1 kHz, before the sink applies the
	  volume) to a client, to hear on another machine what the output is
	  fed with:

	    nc <device> <port> | aplay -f S16_LE -r 44100 -c 2 \
	        -B 1000000 -R 1000000

	  A diagnostic aid: when the copy sounds right but the DAC does not,
	  the fault is in the I2S configuration, the wiring or the DAC.

config ZSPOT_PCM_TAP_PORT
	int "TCP port of the PCM tap"
	default 5000
	depends on ZSPOT_PCM_TAP

choice ZSPOT_AUDIO_QUALITY
	prompt "Stream quality"
	default ZSPOT_AUDIO_QUALITY_160
	help
	  Bit rate of the Ogg Vorbis stream that is asked for. A track that
	  does not come in it is played at 96 kbit/s. More takes more of the
	  network and of the processor.

config ZSPOT_AUDIO_QUALITY_96
	bool "96 kbit/s"

config ZSPOT_AUDIO_QUALITY_160
	bool "160 kbit/s"

config ZSPOT_AUDIO_QUALITY_320
	bool "320 kbit/s"

endchoice

config ZSPOT_AUDIO_FORMAT
	int
	default 0 if ZSPOT_AUDIO_QUALITY_96
	default 2 if ZSPOT_AUDIO_QUALITY_320
	default 1

config ZSPOT_USERNAME
	string "Spotify username (development only)"
	default ""
	help
	  Together with ZSPOT_PASSWORD, logs in with a username and
	  password instead of the zeroconf hand-over. Spotify no longer accepts
	  password logins from third-party clients for most accounts, but the
	  attempt still exercises access point resolution, the handshake and
	  the authentication exchange, which is useful on native_sim.

config ZSPOT_PASSWORD
	string "Spotify password (development only)"
	default ""

config ZSPOT_CREDENTIALS_JSON
	string "Stored credentials (JSON)"
	default ""
	help
	  Output of zspot_credentials_save_json() from a previous session. When
	  set, the sample skips the zeroconf hand-over.

config ZSPOT_CREDENTIALS_STORED
	bool "Keep the Spotify credentials across restarts"
	default y
	depends on SETTINGS
	help
	  Stores the reusable credentials of a session in the settings and
	  signs in with them at the next start, so that the device does not
	  have to be picked in the Spotify app again. Credentials that Spotify
	  rejects are removed, and the device waits for the hand-over again.

	  The device then stays signed in to the account that picked it last.
	  The credentials are stored unencrypted, like the Wi-Fi passwords.
	  Credentials given to the build (ZSPOT_CREDENTIALS_JSON, or
	  ZSPOT_USERNAME and ZSPOT_PASSWORD) take precedence over stored ones.

# The defaults come from the environment of the build, so that the values stay
# out of the repository and of the command line.

config ZSPOT_WEB_CLIENT_ID
	string "Client ID of the Spotify developer application"
	default "$(ZSPOT_WEB_CLIENT_ID)"
	help
	  "Your Library" on the Now Playing screen uses the Spotify Web API,
	  which needs an application registered at developer.spotify.com and a
	  one-time authorisation by the user with scripts/spotify_authorize.py.
	  The three values default to the environment variables
	  ZSPOT_WEB_CLIENT_ID, ZSPOT_WEB_CLIENT_SECRET and
	  ZSPOT_WEB_REFRESH_TOKEN. Without them the library view only says that
	  it is not set up.

config ZSPOT_WEB_CLIENT_SECRET
	string "Client secret of the Spotify developer application"
	default "$(ZSPOT_WEB_CLIENT_SECRET)"

config ZSPOT_WEB_REFRESH_TOKEN
	string "Refresh token of the authorised user"
	default "$(ZSPOT_WEB_REFRESH_TOKEN)"

config ZSPOT_UI
	bool "Now Playing screen (LVGL)"
	depends on LVGL && LV_Z_RUN_LVGL_ON_WORKQUEUE && LV_USE_TJPGD
	help
	  Shows the cover art, title, artist and progress of the current track
	  on the chosen display (the layout follows its resolution) and offers touch
	  controls for play/pause, skipping, seeking and the volume. See
	  prj.conf for the LVGL configuration it needs.

if ZSPOT_UI

config ZSPOT_BATTERY
	bool "Battery indicator"
	default y
	depends on $(dt_alias_enabled,fuel-gauge0)
	select FUEL_GAUGE
	help
	  Shows the charge level reported by the fuel gauge behind the
	  devicetree alias fuel-gauge0 next to the network indicator. Only
	  available when the board has that alias and its node is enabled.

config ZSPOT_BATTERY_POLL_SECONDS
	int "Seconds between two readings of the fuel gauge"
	default 30
	range 1 3600

config ZSPOT_LAST_TRACK
	bool "Show the last song after a restart"
	default y
	depends on ZSPOT_CREDENTIALS_STORED
	help
	  Stores the song that plays in the settings. After a restart the Now
	  Playing screen shows it, paused where it was paused, instead of the
	  notice to pick the device in the Spotify app, and Play starts it on
	  this device, within its playlist or album where it has one.

	  The song is started through the Web API (ZSPOT_WEB_CLIENT_ID and its
	  companions); without that set up, the notice is shown as before.

	  Writing to the flash interrupts the audio, so the song is stored
	  when none goes out: when it is paused, when it was just started,
	  at the end of the queue or when another device takes over. After a
	  loss of power in the middle of a queue that played without a break,
	  the song shown is the one that the queue was started with.

config ZSPOT_SCREEN_TIMEOUT_SECONDS
	int "Seconds without a touch after which the screen turns off"
	default 60
	range 0 3600
	help
	  Turns the display off, and its backlight when the board has the
	  devicetree alias zspot-backlight (a regulator), once the screen has
	  not been touched for this long. The next touch turns it back on and
	  does nothing else. Playback is not affected. 0 keeps the screen on.

endif # ZSPOT_UI

endmenu # zspot player

source "Kconfig.zephyr"
